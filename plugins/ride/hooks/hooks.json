{
  "description": "Surface completed Ambient Ride login QR output in Claude Code's default TUI",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/show-login-qr.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
